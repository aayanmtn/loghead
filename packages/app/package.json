  "scripts": {
    "dev": "next dev",
    "cli": "tsx core/cli_main.ts start",
    "cli:projects": "tsx core/cli_main.ts projects list",
    "dev:log": "next dev | npx @loghead/terminal --base-url http://localhost:3001 --token eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJmOGJlNTk5NS1jNTA5LTQxZTYtYjRlMi0zMGMwYjI0OTU5MjciLCJpc3MiOiJsb2doZWFkIiwidGVuYW50SWQiOiI0VzZXM081ME5Qa0RrMURodGlsTzY3aFZwakN1VXYwUSIsImlhdCI6MTc3NjQ0NTc2OX0._YaOhpfl5LJkD2Q9a8DFR7eDCzOCneOf2KEtyzaoBQIJrdyB_TqJwG_mKEIJzDs7y7vApFN3kppssV-zwUALzw",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npx @better-auth/cli@latest generate",
    "db:migrate": "npx @better-auth/cli@latest migrate --yes && node scripts/bootstrap-postgres.mjs",
    "docker:migrate": "DATABASE_URL=postgresql://postgres:password@localhost:5432/loghead?sslmode=disable BETTER_AUTH_BASE_URL=http://localhost:3000 npx @better-auth/cli@latest migrate --yes && DATABASE_URL=postgresql://postgres:password@localhost:5432/loghead?sslmode=disable BETTER_AUTH_BASE_URL=http://localhost:3000 node scripts/bootstrap-postgres.mjs",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:detach": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:prod:detach": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
