{
  "name": "@loghead/core",
  "version": "0.1.29",
  "type": "module",
  "license": "MIT",
  "description": "Core API and Database for Loghead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onvo-ai/loghead.git"
  },
  "homepage": "https://github.com/onvo-ai/loghead#readme",
  "bugs": {
    "url": "https://github.com/onvo-ai/loghead/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "build/npm"
  ],
  "main": "dist/index.js",
  "bin": {
    "loghead": "./dist/cli_main.js"
  },
  "scripts": {
    "start": "tsx src/cli_main.ts start",
    "ui": "tsx src/cli_main.ts ui",
    "build:frontend": "cd frontend && yarn install && yarn build",
    "build": "npm run build:frontend && tsc",
    "dev:backend": "tsx watch src/cli_main.ts",
    "dev:frontend": "cd frontend && yarn build --watch",
    "dev": "sh -c 'yarn dev:frontend & yarn dev:backend'",
    "deploy": "npm publish --access public"
  },
  "dependencies": {
    "@loghead/db": "*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "inquirer": "^9.2.14",
    "jsonwebtoken": "^9.0.2",
    "ollama": "^0.5.9",
    "open": "^8.4.2",
    "@tursodatabase/database": "^0.4.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/yargs": "^17.0.32",
    "tsx": "^4.21.0"
  }
}
