{
  "name": "loghead",
  "displayName": "Loghead",
  "description": "Code editor extension for loghead",
  "version": "0.0.3",
  "publisher": "OnvoAI",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/onvo-ai/loghead.git"
  },
  "engines": {
    "vscode": ">=1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:loghead.server",
    "onView:loghead.projects",
    "onView:loghead.logs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loghead",
          "title": "Loghead",
          "icon": "media/logo.png"
        }
      ]
    },
    "views": {
      "loghead": [
        {
          "id": "loghead.server",
          "name": "Server"
        },
        {
          "id": "loghead.projects",
          "name": "Projects"
        },
        {
          "id": "loghead.logs",
          "name": "Logs"
        }
      ]
    },
    "commands": [
      {
        "command": "loghead.openDashboard",
        "title": "Loghead: Open Dashboard"
      },
      {
        "command": "loghead.connectCloud",
        "title": "Connect to Loghead Cloud"
      },
      {
        "command": "loghead.disconnectCloud",
        "title": "Disconnect from Loghead Cloud"
      },
      {
        "command": "loghead.createProject",
        "title": "Create Project",
        "icon": "$(add)"
      },
      {
        "command": "loghead.createStream",
        "title": "Create Stream",
        "icon": "$(add)"
      },
      {
        "command": "loghead.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "loghead.refreshLogs",
        "title": "Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "loghead.deleteProject",
        "title": "Delete Project"
      },
      {
        "command": "loghead.copyStreamToken",
        "title": "Copy Stream Token"
      },
      {
        "command": "loghead.copyStreamIngest",
        "title": "Copy Stream Ingest Command"
      },
      {
        "command": "loghead.deleteStream",
        "title": "Delete Stream"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loghead.createProject",
          "when": "view == loghead.projects",
          "group": "navigation"
        },
        {
          "command": "loghead.refresh",
          "when": "view == loghead.projects",
          "group": "navigation"
        },
        {
          "command": "loghead.refreshLogs",
          "when": "view == loghead.logs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "loghead.copyStreamToken",
          "when": "view == loghead.projects && viewItem == stream",
          "group": "inline"
        },
        {
          "command": "loghead.copyStreamIngest",
          "when": "view == loghead.projects && viewItem == stream",
          "group": "inline"
        },
        {
          "command": "loghead.deleteProject",
          "when": "view == loghead.projects && viewItem == project",
          "group": "danger"
        },
        {
          "command": "loghead.deleteStream",
          "when": "view == loghead.projects && viewItem == stream",
          "group": "danger"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "npm run compile && code --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
